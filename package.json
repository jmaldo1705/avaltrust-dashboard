{
  "name": "avaltrust-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve dashboard",
    "build": "ng build dashboard --configuration production",
    "build:dev": "ng build dashboard --configuration development",
    "watch": "ng build dashboard --watch --configuration development",
    "test": "ng test dashboard",
    "start:landing": "ng serve landing",
    "build:landing": "ng build landing --configuration production",
    "test:landing": "ng test landing"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/ssr": "22.2.1",
    "@lucide/angular": "^1.49.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@types/node": "^24.19.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
