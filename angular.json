{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dashboard": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/dashboard",
      "sourceRoot": "projects/dashboard/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/dashboard/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/dashboard/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/dashboard/public"
              },
              {
                "glob": "**/*",
                "input": "projects/dashboard/src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "projects/dashboard/src/styles.css"
            ],
            "outputPath": "dist/avaltrust-dashboard"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/dashboard/src/app/environments/environment.ts",
                  "with": "projects/dashboard/src/app/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.3MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "25kB",
                  "maximumError": "40kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "avaltrust-dashboard:build:production"
            },
            "development": {
              "buildTarget": "avaltrust-dashboard:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/dashboard/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/dashboard/public"
              },
              {
                "glob": "**/*",
                "input": "projects/dashboard/src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "projects/dashboard/src/styles.css"
            ]
          }
        }
      }
    },
    "landing": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/landing",
      "sourceRoot": "projects/landing/src",
      "prefix": "at",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/landing/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/landing/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/landing/public"
              }
            ],
            "styles": [
              "projects/landing/src/styles.css"
            ],
            "server": "projects/landing/src/main.server.ts",
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            },
            "outputPath": "dist/landing"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "landing:build:production"
            },
            "development": {
              "buildTarget": "landing:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/landing/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/landing/public"
              }
            ],
            "styles": [
              "projects/landing/src/styles.css"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
